// Rule 03: Anonymous NTLM network logon from an external IP
// MITRE: Discovery / T1135 (Network Share Discovery), Lateral Movement / T1021.002 (SMB/Windows Admin Shares)
// Severity: Low (reconnaissance, not compromise)
// Schedule: every 1 h, lookback 1 h
// Entities: IpAddress -> IP
// Incident grouping: one incident per IpAddress
// Note: a 4624 only shows the session was created; check 5140/5145 for any share access.
// Status: tested; matches 163.121.35.2, 175.107.201.26 and several single-hit scanner IPs
let lookback = 1h;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4624 and LogonType == 3
| where Account has "ANONYMOUS LOGON"
| where IpAddress !in ("-", "", "::1", "127.0.0.1")
| summarize Logons = count(),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IpAddress, AuthenticationPackageName, LmPackageName
