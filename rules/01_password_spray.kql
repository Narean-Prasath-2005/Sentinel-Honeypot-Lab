// Rule 01: Password spray - one source IP trying many distinct usernames
// MITRE: Credential Access / T1110.003 (Password Spraying)
// Severity: Medium
// Schedule: every 30 min, lookback 1 h
// Entities: IpAddress -> IP
// Incident grouping: one incident per IpAddress
// Status: tested against Oct 7-10 data; fires on 144.76.103.122, 77.91.122.16, 193.143.1.66
// Note: counts 4625 only (4776 duplicates every failure)
let lookback = 1h;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4625 and LogonType in (3, 10)
| where IpAddress !in ("-", "", "::1", "127.0.0.1")
| summarize Attempts = count(),
            DistinctUsers = dcount(TargetUserName),
            SampleUsers = make_set(TargetUserName, 10),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IpAddress
| where DistinctUsers >= 20 and Attempts >= 50

