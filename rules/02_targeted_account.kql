// Rule 02: Real username targeted - wrong password on an account that exists
// MITRE: Credential Access / T1110.001 (Password Guessing)
// Severity: Medium (raise to High if Lockouts > 0)
// Schedule: every 15-30 min, lookback 1 h
// Entities: IpAddress -> IP, TargetUserName -> Account
// Incident grouping: one incident per IpAddress + TargetUserName
// SubStatus 0xC000006A = valid account, wrong password (much higher signal than 0xC0000064, unknown user)
// Status: tested; expected hits 23.94.69.14 and 138.91.109.48 against azureuser
let lookback = 1h;
let lockouts = SecurityEvent
    | where TimeGenerated > ago(lookback)
    | where EventID == 4740
    | summarize Lockouts = count() by TargetUserName;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4625 and LogonType in (3, 10)
| where SubStatus =~ "0xc000006a"
| where IpAddress !in ("-", "", "::1", "127.0.0.1")
| summarize WrongPasswords = count(),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IpAddress, TargetUserName
| where WrongPasswords >= 5
| join kind=leftouter lockouts on TargetUserName
| extend Lockouts = coalesce(Lockouts, long(0))
| project IpAddress, TargetUserName, WrongPasswords, Lockouts, FirstSeen, LastSeen
